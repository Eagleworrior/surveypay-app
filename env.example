# Copy to .env and fill in. NEVER commit .env or paste these into chats.
PORT=3000
PUBLIC_URL=https://your-domain.example      # public HTTPS URL Safaricom can reach
ALLOWED_ORIGIN=https://your-frontend.example
JWT_SECRET=change-me-to-a-long-random-string
CALLBACK_SECRET=another-long-random-string  # part of the callback URLs

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Daraja (rotate the keys you posted in chat and put the NEW ones here)
MPESA_KEY=
MPESA_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline        # CustomerBuyGoodsOnline for a till
MPESA_PARTYB=                               # defaults to MPESA_SHORTCODE
# B2C (withdrawals)
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=                  # initiator password encrypted with Safaricom's production cert

# Business rules (shown to users by the front end via /api/config)
ACTIVATION_FEE=200
FREE_SURVEYS=3
MIN_WITHDRAW=500

# Admin page (/admin.html). Long random value. Leave empty to disable admin.
ADMIN_TOKEN=
